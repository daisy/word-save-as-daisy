<Window x:Class="Daisy.SaveAsDAISY.WPF.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Daisy.SaveAsDAISY.WPF"
        xmlns:customs="clr-namespace:Daisy.SaveAsDAISY.WPF.CustomControls"
        mc:Ignorable="d"
        Title="SaveAsDAISY Settings"
        SizeToContent="Height"
        Width="740">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Label Content="Results directory"
           VerticalAlignment="Center"
           HorizontalAlignment="Left"
           Margin="5,0,0,0"
           x:Name="OutputDirectoryLabel"
           />
            <TextBox TextWrapping="NoWrap"
             Text=""
             VerticalAlignment="Center"
             x:Name="ResultsPath"
             Margin="130,0,75,0"
             AutomationProperties.LabeledBy="{Binding ElementName=OutputDirectoryLabel}" />
            <Button Content="Browse"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            AutomationProperties.HelpText="Browse for a configuration file"
            Width="62"
            x:Name="BrowseResultsFolder"
            Click="BrowseResultsFolder_Click"
            Margin="0,0,5,0" />
        </Grid>
        <CheckBox Content="Disable sponsorship notifications"
            Margin="10,5,5,5"
            x:Name="DisableSponsorship"
                  DockPanel.Dock="Top"
         />
        <TabControl Margin="5" DockPanel.Dock="Top">
            <TabItem Header="Conversion settings">
                <StackPanel Margin="5">
                    <Grid>
                        <Label Content="Page numbering"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="5"
                       x:Name="PageNumberingLabel" />
                        <ComboBox Margin="130,5,5,5"
                          VerticalAlignment="Center"
                          x:Name="PageNumbering"
                          SelectionChanged="PageNumbering_SelectionChanged"
                          AutomationProperties.LabeledBy="{Binding ElementName=PageNumberingLabel}" />
                    </Grid>
                    <Grid x:Name="PageMarkerGrid">
                        <Label Content="Page marker"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="5"
                       x:Name="PageMarkerLabel" />
                        <TextBox TextWrapping="Wrap"
                        Margin="130,2,2,2"
                        Text=""
                        VerticalAlignment="Center"
                        x:Name="PageMarker"
                        AutomationProperties.LabeledBy="{Binding ElementName=PageMarkerLabel}" />
                    </Grid>
                    <CheckBox Content="Translate character styles"
                      Margin="10,5,5,5"
                      x:Name="TranslateCharacteStyles" />
                    <Grid VerticalAlignment="Center">
                        <Label Content="Image size options"
                       Margin="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       x:Name="ImageSizeOptionsLabel" />
                        <ComboBox Margin="130,5,5,5"
                          VerticalAlignment="Center"
                          x:Name="ImageSizeOptions"
                          AutomationProperties.LabeledBy="{Binding ElementName=ImageSizeOptionsLabel}"
                          SelectionChanged="ImageSizeOptions_SelectionChanged" />
                    </Grid>
                    <Grid>
                        <Label Content="Resampling to"
                       HorizontalAlignment="Left"
                       Margin="5"
                       VerticalAlignment="Center"
                       x:Name="ResamplingLabel" />
                        <ComboBox Margin="130,5,5,5"
                      VerticalAlignment="Center"
                      x:Name="Resampling"
                      AutomationProperties.LabeledBy="{Binding ElementName=ResamplingLabel}"
                      IsEnabled="False" />
                    </Grid>

                </StackPanel>
            </TabItem>
            <!--<TabItem Header="Export scripts settings" HorizontalAlignment="Left" Width="128">
            <StackPanel Margin="5" x:Name="ScriptOptions">
                <customs:BooleanParameter x:Name="SomeBooleanParameter"
                                          ParameterName="Name" 
                                            ParameterDescription="Description" />
            </StackPanel>
        </TabItem>-->
            <TabItem Header="Footnotes customization">
                <StackPanel Margin="5">
                    <Grid>
                        <Label Content="Notes position"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="2"
                       x:Name="NotesPositionLabel" />
                        <ComboBox Margin="150,2,2,2"
                          VerticalAlignment="Center"
                          x:Name="NotesPosition"
                          AutomationProperties.LabeledBy="{Binding ElementName=NotesPositionLabel}" />
                    </Grid>
                    <Grid>
                        <Label Content="Notes level"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       x:Name="NotesLevelLabel"
                       Margin="2" />
                        <ComboBox VerticalAlignment="Center"
                          x:Name="NotesLevel"
                          Margin="150,2,2,2"
                          AutomationProperties.LabeledBy="{Binding ElementName=NotesLevelLabel}" />
                    </Grid>
                    <Grid>
                        <Label Content="Notes numbering"
                       VerticalAlignment="Center"
                       Margin="2"
                       x:Name="NotesNumberingLabel" />
                        <ComboBox VerticalAlignment="Center"
                          x:Name="NotesNumbering"
                          Margin="150,2,2,2"
                          SelectionChanged="NotesNumbering_SelectionChanged"
                          AutomationProperties.LabeledBy="{Binding ElementName=NotesNumberingLabel}" />
                    </Grid>
                    <Grid>
                        <Label Content="Start number"
                       Margin="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       x:Name="StartNumberLabel" />
                        <TextBox TextWrapping="Wrap"
                         Margin="150,2,2,2"
                         Text="___"
                         VerticalAlignment="Center"
                         x:Name="StartNumber"
                         AutomationProperties.LabeledBy="{Binding ElementName=StartNumberLabel}"
                         PreviewTextInput="StartNumber_PreviewTextInput"
                         DataObject.Pasting="StartNumber_Pasting" />
                    </Grid>
                    <Grid>
                        <Label Content="Number prefix"
                       Margin="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       x:Name="NumberPrefixLabel" />
                        <TextBox TextWrapping="Wrap"
                         Margin="150,2,2,2"
                         Text=""
                         VerticalAlignment="Center"
                         x:Name="NumberPrefix"
                         AutomationProperties.LabeledBy="{Binding ElementName=NumberPrefixLabel}" />
                    </Grid>
                    <Grid>
                        <Label Content="Notes text prefix"
                       Margin="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       x:Name="NotesTextPrefixLabel" />
                        <TextBox TextWrapping="Wrap"
                         Margin="150,2,2,2"
                         Text=""
                         VerticalAlignment="Center"
                         x:Name="NotesTextPrefix"
                         AutomationProperties.LabeledBy="{Binding ElementName=NotesTextPrefixLabel}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Import script settings">
                <StackPanel Margin="5">
                    <Label Content="Default template for dtbook to ODT imports"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   x:Name="OpenOfficeTemplateLabel" />
                    <Grid>
                        <TextBox TextWrapping="NoWrap"
                         Text=""
                         VerticalAlignment="Center"
                         x:Name="OpenOfficeTemplate"
                         Margin="0,0,77,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=OpenOfficeTemplateLabel}" />
                        <Button Content="Browse"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        AutomationProperties.HelpText="Browse for a configuration file"
                        Width="72"
                        x:Name="BrowseOpenOfficeTemplate"
                        Click="BrowseOpenOfficeTemplate_Click" />
                    </Grid>
                    <Label Content="Mistral API key for PDF OCR"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   x:Name="MistralApiKeyLabel" />
                    <Grid>
                        <TextBox TextWrapping="NoWrap"
                         Text=""
                         VerticalAlignment="Center"
                         x:Name="MistralApiKey"
                         AutomationProperties.LabeledBy="{Binding ElementName=MistralApiKeyLabel}" />
                    </Grid>
                    <Label Content="Datalab API key for PDF OCR"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        x:Name="DatalabApiKeyLabel" />
                    <Grid>
                        <TextBox TextWrapping="NoWrap"
                            Text=""
                            VerticalAlignment="Center"
                            x:Name="DatalabApiKey"
                            AutomationProperties.LabeledBy="{Binding ElementName=DatalabApiKeyLabel}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="DAISY Pipeline 2 engine">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                        <Button Width="200" Margin="5" HorizontalAlignment="Left" x:Name="OpenPipelineProperties" Click="OpenPipelineProperties_Click">Embedded Pipeline Properties</Button>
                        <Label x:Name="LoadingPropertiesStatus"
                       Content=""
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="5,0,5,5" />
                    </StackPanel>

                    <Label Content="Embedded engine Text-to-speech configuration file"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   x:Name="TTSConfigFileLabel" />
                    <Grid>
                        <TextBox TextWrapping="NoWrap"
                         Text=""
                         VerticalAlignment="Center"
                         x:Name="TTSConfigFile"
                         Margin="0,0,77,0"
                         AutomationProperties.LabeledBy="{Binding ElementName=TTSConfigFileLabel}" />
                        <Button Content="Browse"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        AutomationProperties.HelpText="Browse for a configuration file"
                        Width="72"
                        x:Name="BrowseTTSConfigFile"
                        Click="BrowseTTSConfigFile_Click" />
                    </Grid>

                    <CheckBox Content="Use DAISY Pipeline App instead of embedded engine"
                      VerticalAlignment="Center"
                      Margin="5"
                      x:Name="UseDAISYPipelineApp"
                      Checked="UseDAISYPipelineApp_Checked"
                      Unchecked="UseDAISYPipelineApp_Unchecked" />

                    <UniformGrid Columns="3"
                         Height="23"
                         VerticalAlignment="Center">
                        <Button Content="Browse voices"
                        Width="100"
                        x:Name="BrowseVoices"
                        Click="BrowseVoices_Click"
                        AutomationProperties.HelpText="Open DAISY Pipeline App voices browser"
                        Height="20" />
                        <Button Content="Preferred voices"
                        x:Name="PreferredVoices"
                        Click="PreferredVoices_Click"
                        AutomationProperties.HelpText="Open DAISY Pipeline App preferred voices settings"
                        Width="150"
                        Height="20" />
                        <Button Content="External services"
                        x:Name="TTSEngines"
                        Click="TTSEngines_Click"
                        AutomationProperties.HelpText="Open DAISY Pipeline App Text-to-speech engines settings"
                        Height="20"
                        Width="100" />
                    </UniformGrid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                FlowDirection="RightToLeft"
                VerticalAlignment="Bottom"
                Margin="5,0,5,5"
            >
            <Button Content="OK"
                x:Name="Save"
                Click="Save_Click"
                Width="75"
                Margin="5"
                VerticalAlignment="Center" />
                <Button Content="Cancel"
                x:Name="Cancel"
                Click="Cancel_Click"
                Margin="5"
                Width="75"
                VerticalAlignment="Center" />
        </StackPanel>
    </DockPanel>
</Window>
